{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/draft.schema.json",
  "title": "Editorial draft output",
  "description": "The content of one suggestion. Field names follow #336's submitSuggestion tool; the server maps them to the Events or Posts fields and converts bodyMarkdown to rich text. For posts, the time and place fields are null.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "collection": {
      "enum": ["events", "posts"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bodyMarkdown": {
      "description": "Under 300 words of Markdown: what, when, where, one action, why it matters to Sprecher East, official links.",
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "startsAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "endsAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "allDay": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "venue": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "address": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/audience"
      },
      "uniqueItems": true
    },
    "officialLinks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/httpUrl"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true
    }
  },
  "required": [
    "collection",
    "title",
    "bodyMarkdown",
    "startsAt",
    "endsAt",
    "allDay",
    "venue",
    "address",
    "audience",
    "officialLinks",
    "confidence",
    "missing"
  ]
}
