{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/eval-cases.schema.json",
  "title": "Evaluation cases (evals/<stage>.yaml)",
  "description": "One file per stage. CI checks the structure only: schemas, routes, targets, offsets and grader fields. Running the cases against a model is the collector's job (#272).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asOf", "stage", "cases"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "asOf": {
      "description": "The date the expected results assume as today.",
      "$ref": "common.schema.json#/$defs/date"
    },
    "stage": {
      "enum": ["scout", "verify", "curate", "draft", "submit"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "input", "expected", "why"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/sourceId"
          },
          "ref": {
            "description": "The case's id in #352's proposal, such as S1 or V10a.",
            "type": "string",
            "pattern": "^[A-Z]{1,2}[0-9]{1,2}[a-z]?$"
          },
          "stage": {
            "enum": ["scout", "verify", "curate", "draft", "submit"]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/sourceId"
            }
          },
          "input": {
            "anyOf": [
              {
                "description": "What the fetch returned, in order: the first response, then a retry or the Playwright render.",
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "responses"],
                "properties": {
                  "sourceId": {
                    "$ref": "common.schema.json#/$defs/sourceId"
                  },
                  "responses": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["via", "status"],
                      "properties": {
                        "via": {
                          "enum": ["direct", "retry", "playwright"]
                        },
                        "status": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        "contentType": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "redirectTo": {
                          "$ref": "common.schema.json#/$defs/httpUrl"
                        },
                        "body": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      }
                    }
                  },
                  "otherSources": {
                    "description": "Another pilot source's answer in the same run, for cross-source matching.",
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["sourceId", "body"],
                      "properties": {
                        "sourceId": {
                          "$ref": "common.schema.json#/$defs/sourceId"
                        },
                        "body": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      }
                    }
                  }
                }
              },
              {
                "description": "A candidate with only the fields the case needs. A missing sourceStatus means scheduled. sourceUrl may be null to test validation.",
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "title", "startsAt", "locationText"],
                "properties": {
                  "sourceId": {
                    "$ref": "candidate.schema.json#/properties/sourceId"
                  },
                  "externalId": {
                    "$ref": "candidate.schema.json#/properties/externalId"
                  },
                  "contentHash": {
                    "$ref": "candidate.schema.json#/properties/contentHash"
                  },
                  "kind": {
                    "$ref": "candidate.schema.json#/properties/kind"
                  },
                  "title": {
                    "$ref": "candidate.schema.json#/properties/title"
                  },
                  "sourceText": {
                    "$ref": "candidate.schema.json#/properties/sourceText"
                  },
                  "startsAt": {
                    "$ref": "candidate.schema.json#/properties/startsAt"
                  },
                  "endsAt": {
                    "$ref": "candidate.schema.json#/properties/endsAt"
                  },
                  "allDay": {
                    "$ref": "candidate.schema.json#/properties/allDay"
                  },
                  "locationText": {
                    "$ref": "candidate.schema.json#/properties/locationText"
                  },
                  "sourceStatus": {
                    "$ref": "candidate.schema.json#/properties/sourceStatus"
                  },
                  "change": {
                    "$ref": "candidate.schema.json#/properties/change"
                  },
                  "alsoReportedBy": {
                    "$ref": "candidate.schema.json#/properties/alsoReportedBy"
                  },
                  "sourceUrl": {
                    "anyOf": [
                      {
                        "$ref": "candidate.schema.json#/properties/sourceUrl"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "known": {
            "$ref": "item.schema.json#/properties/known"
          },
          "given": {
            "description": "Earlier stages' output and the run's state, as far as the case needs them.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "location": {
                    "$ref": "verification.schema.json#/properties/location"
                  },
                  "coverage": {
                    "$ref": "verification.schema.json#/properties/coverage"
                  },
                  "coverageReason": {
                    "$ref": "verification.schema.json#/properties/coverageReason"
                  },
                  "confidence": {
                    "$ref": "verification.schema.json#/properties/confidence"
                  },
                  "dateConfirmed": {
                    "$ref": "verification.schema.json#/properties/dateConfirmed"
                  },
                  "statusConfirmed": {
                    "$ref": "verification.schema.json#/properties/statusConfirmed"
                  },
                  "evidence": {
                    "$ref": "verification.schema.json#/properties/evidence"
                  },
                  "unknowns": {
                    "$ref": "verification.schema.json#/properties/unknowns"
                  },
                  "flags": {
                    "$ref": "verification.schema.json#/properties/flags"
                  }
                }
              },
              "curation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "$ref": "curation.schema.json#/properties/decision"
                  },
                  "reasons": {
                    "$ref": "curation.schema.json#/properties/reasons"
                  },
                  "scores": {
                    "$ref": "curation.schema.json#/properties/scores"
                  },
                  "audiences": {
                    "$ref": "curation.schema.json#/properties/audiences"
                  },
                  "whyItMatters": {
                    "$ref": "curation.schema.json#/properties/whyItMatters"
                  },
                  "residentAction": {
                    "$ref": "curation.schema.json#/properties/residentAction"
                  },
                  "targetCollection": {
                    "$ref": "curation.schema.json#/properties/targetCollection"
                  },
                  "targetId": {
                    "$ref": "curation.schema.json#/properties/targetId"
                  }
                }
              },
              "draft": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "collection": {
                    "$ref": "draft.schema.json#/properties/collection"
                  },
                  "title": {
                    "$ref": "draft.schema.json#/properties/title"
                  },
                  "bodyMarkdown": {
                    "$ref": "draft.schema.json#/properties/bodyMarkdown"
                  },
                  "startsAt": {
                    "$ref": "draft.schema.json#/properties/startsAt"
                  },
                  "endsAt": {
                    "$ref": "draft.schema.json#/properties/endsAt"
                  },
                  "allDay": {
                    "$ref": "draft.schema.json#/properties/allDay"
                  },
                  "venue": {
                    "$ref": "draft.schema.json#/properties/venue"
                  },
                  "address": {
                    "$ref": "draft.schema.json#/properties/address"
                  },
                  "audience": {
                    "$ref": "draft.schema.json#/properties/audience"
                  },
                  "officialLinks": {
                    "$ref": "draft.schema.json#/properties/officialLinks"
                  },
                  "confidence": {
                    "$ref": "draft.schema.json#/properties/confidence"
                  },
                  "missing": {
                    "$ref": "draft.schema.json#/properties/missing"
                  }
                }
              },
              "run": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "draftsSoFar": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mcpAnswers": {
                    "type": "array",
                    "items": {
                      "enum": ["created", "duplicate", "transient-error"]
                    },
                    "maxItems": 4
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decision": {
                "$ref": "common.schema.json#/$defs/decision"
              },
              "coverage": {
                "$ref": "common.schema.json#/$defs/coverage"
              },
              "flags": {
                "description": "Flags the output must include.",
                "$ref": "common.schema.json#/$defs/flags"
              },
              "flagsAbsent": {
                "description": "Flags the output must not include.",
                "$ref": "common.schema.json#/$defs/flags"
              },
              "route": {
                "description": "The MCP tool the submit stage calls: accept \u2192 submitSuggestion; needs-review, update, cancel \u2192 reportItem; reject, duplicate \u2192 none.",
                "enum": ["submitSuggestion", "reportItem", "none"]
              },
              "reportKind": {
                "$ref": "report.schema.json#/properties/kind"
              },
              "targetCollection": {
                "$ref": "curation.schema.json#/properties/targetCollection"
              },
              "targetId": {
                "$ref": "curation.schema.json#/properties/targetId"
              },
              "escalated": {
                "description": "Verify was rerun at high effort.",
                "type": "boolean"
              },
              "fetchStrategy": {
                "$ref": "common.schema.json#/$defs/fetchUsed"
              },
              "runStatus": {
                "enum": ["ok", "not-modified", "error", "skipped", "blocked"],
                "description": "skipped: not polled (not valid or cadence); blocked: stopped at a gate (login, paywall, CAPTCHA, robots.txt); error: failed after its one retry."
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "candidateCount": {
                "type": "integer",
                "minimum": 0
              },
              "deferred": {
                "description": "Left for the next run, not marked as seen.",
                "type": "boolean"
              }
            }
          },
          "graders": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check", "field"],
                  "properties": {
                    "check": {
                      "enum": [
                        "equals",
                        "present",
                        "isNull",
                        "contains",
                        "notContains",
                        "notMatches",
                        "lessThan",
                        "maxNgramOverlap"
                      ]
                    },
                    "field": {
                      "description": "A field of the stage's input or output schema, written $.path; the check confirms it exists.",
                      "type": "string",
                      "pattern": "^\\$\\.[A-Za-z0-9_.\\[\\]]+$"
                    },
                    "value": {
                      "description": "What to compare with: a value, a substring, a regular expression, or a number."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check", "rubric"],
                  "properties": {
                    "check": {
                      "const": "model"
                    },
                    "rubric": {
                      "type": "string",
                      "minLength": 10,
                      "maxLength": 600
                    }
                  }
                }
              ]
            }
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "scout"
                }
              }
            },
            "then": {
              "properties": {
                "input": {
                  "description": "What the fetch returned, in order: the first response, then a retry or the Playwright render.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceId", "responses"],
                  "properties": {
                    "sourceId": {
                      "$ref": "common.schema.json#/$defs/sourceId"
                    },
                    "responses": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["via", "status"],
                        "properties": {
                          "via": {
                            "enum": ["direct", "retry", "playwright"]
                          },
                          "status": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          },
                          "contentType": {
                            "type": "string",
                            "maxLength": 100
                          },
                          "redirectTo": {
                            "$ref": "common.schema.json#/$defs/httpUrl"
                          },
                          "body": {
                            "type": "string",
                            "maxLength": 4000
                          }
                        }
                      }
                    },
                    "otherSources": {
                      "description": "Another pilot source's answer in the same run, for cross-source matching.",
                      "type": "array",
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sourceId", "body"],
                        "properties": {
                          "sourceId": {
                            "$ref": "common.schema.json#/$defs/sourceId"
                          },
                          "body": {
                            "type": "string",
                            "maxLength": 4000
                          }
                        }
                      }
                    }
                  }
                },
                "expected": {
                  "required": ["fetchStrategy", "runStatus"],
                  "type": "object",
                  "properties": {
                    "fetchStrategy": true,
                    "runStatus": true
                  }
                }
              }
            },
            "else": {
              "properties": {
                "input": {
                  "description": "A candidate with only the fields the case needs. A missing sourceStatus means scheduled. sourceUrl may be null to test validation.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceId", "title", "startsAt", "locationText"],
                  "properties": {
                    "sourceId": {
                      "$ref": "candidate.schema.json#/properties/sourceId"
                    },
                    "externalId": {
                      "$ref": "candidate.schema.json#/properties/externalId"
                    },
                    "contentHash": {
                      "$ref": "candidate.schema.json#/properties/contentHash"
                    },
                    "kind": {
                      "$ref": "candidate.schema.json#/properties/kind"
                    },
                    "title": {
                      "$ref": "candidate.schema.json#/properties/title"
                    },
                    "sourceText": {
                      "$ref": "candidate.schema.json#/properties/sourceText"
                    },
                    "startsAt": {
                      "$ref": "candidate.schema.json#/properties/startsAt"
                    },
                    "endsAt": {
                      "$ref": "candidate.schema.json#/properties/endsAt"
                    },
                    "allDay": {
                      "$ref": "candidate.schema.json#/properties/allDay"
                    },
                    "locationText": {
                      "$ref": "candidate.schema.json#/properties/locationText"
                    },
                    "sourceStatus": {
                      "$ref": "candidate.schema.json#/properties/sourceStatus"
                    },
                    "change": {
                      "$ref": "candidate.schema.json#/properties/change"
                    },
                    "alsoReportedBy": {
                      "$ref": "candidate.schema.json#/properties/alsoReportedBy"
                    },
                    "sourceUrl": {
                      "anyOf": [
                        {
                          "$ref": "candidate.schema.json#/properties/sourceUrl"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": ["verify", "curate"]
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "required": ["decision", "coverage", "route"],
                  "type": "object",
                  "properties": {
                    "decision": true,
                    "coverage": true,
                    "route": true
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "enum": ["draft", "submit"]
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "required": ["route"],
                  "type": "object",
                  "properties": {
                    "route": true
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
