{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/item.schema.json",
  "title": "One item as it moves through the stages",
  "description": "Each stage reads the item and adds its own section; earlier sections are never changed.",
  "type": "object",
  "required": ["candidate"],
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "candidate.schema.json"
    },
    "verification": {
      "$ref": "verification.schema.json"
    },
    "curation": {
      "$ref": "curation.schema.json"
    },
    "draft": {
      "$ref": "draft.schema.json"
    }
  }
}
