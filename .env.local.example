# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Required: at least 32 random characters, used for JWT signing
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# SQLite database path (relative to project root)
DATABASE_URI=file:./data/payload.db

# Public URL of the site (used by Payload for image URLs, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Site Configuration ──────────────────────────────────────────────────────
# IANA timezone for date display and "upcoming" event logic (default: America/Chicago)
SITE_TIMEZONE=America/Chicago

# ─── Preview (Draft Mode) ───────────────────────────────────────────────────
PREVIEW_SECRET=your-preview-secret

# ─── Social Login (Future — via payload-oauth2) ─────────────────────────────
# Google (https://console.cloud.google.com → APIs & Services → Credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Spam protection (Cloudflare Turnstile, free) ───────────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile (Managed mode) for your domain.
# Set BOTH or neither: `npm run build` refuses to build with only one. (If one key goes missing
# from a running build, the check stays off and an error is logged; the site keeps working.)
# The site key is built into the page, so add or change it BEFORE a build (deploy), not just a restart.
# Tokens are accepted only from the NEXT_PUBLIC_SERVER_URL hostname; list any other hostname the
# site is served on (comma-separated) in TURNSTILE_ALLOWED_HOSTNAMES. Test keys skip this check.
# The site key is public; the secret is not.
# Cloudflare test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# Used for password resets and form-builder emails. Leave SMTP_HOST unset to log emails
# to the console instead (local dev, CI). Production: Mailgun SMTP for mg.sprechereast.org.
# SMTP_HOST=smtp.mailgun.org
# Port 465 = implicit TLS; any other port must offer STARTTLS when SMTP_USER is set.
# SMTP_PORT=587
# SMTP_USER=you@mg.example.com
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=Sprecher East
# Missing SMTP_FROM_ADDRESS, or SMTP_USER without SMTP_PASS, logs an error and falls back to console logging.
# Contact form (used when seeding a fresh database): who receives website messages, and the sender.
# CONTACT_NOTIFY_EMAIL=you@example.com
# Optional sender override; leave unset to use SMTP_FROM_NAME <SMTP_FROM_ADDRESS>.
# CONTACT_EMAIL_FROM="Sprecher East" <no-reply@example.com>
